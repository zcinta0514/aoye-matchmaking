# 复制为 .env.local 后填入真实值（.env.local 已被 gitignore，不会入库）。
# 环境变量优先于本文件；只读取 AOYE_LLM_* 前缀的键；启动日志不会回显 key。
# 值不加引号，每行一条：KEY=VALUE

# OpenAI 兼容接口（只需 base_url，日志与接口只显示协议+域名）
AOYE_LLM_BASE_URL=https://your-provider.example.com/v1
# 模型凭据（必填；不要提交到 git、不要贴进对话）
AOYE_LLM_API_KEY=sk-REPLACE_ME
# 支持图片输入的模型名
AOYE_LLM_MODEL=gpt-4o-mini
# auto=发送照片 / off=只发文字
AOYE_LLM_VISION=auto
# 调用超时（毫秒）
AOYE_LLM_TIMEOUT_MS=60000
# 单次请求发给模型的照片总量上限（MB）
AOYE_LLM_MAX_IMAGE_MB=8

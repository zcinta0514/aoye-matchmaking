      "conflict": false,
      "evidence": []
    },
    {
      "id": "R-BASE-SCORE-004",
      "scope": "scoring",
      "title": "自评低于维度映射区间时的分歧说明",
      "when": "自评比照片维度映射区间低 ≥1 分",
      "then": "说明分歧来源：长期低自尊、参照系过高；建议按照片区间上沿重新校准。",

  "rules": [
    {
      "id": "R-BASE-SCORE-001",
      "scope": "scoring",
      "title": "自评 ≥7 分需验证原生脸（知识库 R-SCORE-001 的结构化镜像）",
      "when": "自评颜值 ≥7 且面部不是原生未整",
      "then": "先验证原生脸：未确认前 7 分档不成立，区间上限压到 6.5（知识库 R-SCORE-001 的结构化镜像）。",
      "machine": {
        "when": {
          "all": [
            {
              "field": "subject.self_appearance",
              "op": "gte",
              "value": 7
            },
            {
              "field": "subject.face_natural",
              "op": "neq",
              "value": "yes"
            }
          ]
        },
        "then": [
          {
            "kind": "clampScale",
            "scale": "appearance",
            "max": 6.5
          },
          {
            "kind": "advice",
            "id": "ADV-BASE-001",
            "severity": "warn",
            "text": "自评 ≥7 分但面部非原生未整，颜值分区间上限压到 6.5：知识库 R-SCORE-001 要求 7 分档必须是原生脸。"
          }
        ]
      },
      "confidence": "low",
      "conflict": false,
      "evidence": [],
      "mirrors": "R-SCORE-001"
    },
    {
      "id": "R-BASE-SCORE-002",
      "scope": "scoring",
      "title": "高自评 + 重度精修照片时给上限设闸",
      "when": "自评颜值 ≥7 且照片为重度精修",
      "then": "照片无法验证原生基础：区间上限压到 6.5，提示补原相机正脸 / 半身照。",
      "machine": {
        "when": {
          "all": [
            {
              "field": "subject.self_appearance",
              "op": "gte",
              "value": 7
            },
            {
              "field": "subject.photo_quality",
              "op": "eq",
              "value": "heavy"
            }
          ]
        },
        "then": [
          {
            "kind": "clampScale",
            "scale": "appearance",
            "max": 6.5
          },
          {
            "kind": "advice",
            "id": "ADV-BASE-002",
            "severity": "warn",
            "text": "自评 ≥7 分且上传照片为重度精修，无法验证原生基础。先补一组原相机正脸 / 半身照，再评估 7 分档。"
          }
        ]
      },
      "confidence": "low",
      "conflict": false,
      "evidence": []
    },
    {
      "id": "R-BASE-SCORE-003",
      "scope": "scoring",
      "title": "自评高于维度映射区间时的分歧说明",
      "when": "自评比照片维度映射区间高 ≥1 分",
      "then": "说明分歧来源：熟悉度滤镜 / 妆造加成 / 照片挑选偏向，也可能是拍摄条件没拍出真实水平。",
      "machine": {
        "when": {
          "all": [
